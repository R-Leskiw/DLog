# Copy to .env.local — never commit real secrets (see .cursorrules).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase dashboard (free plan) ---
# 1. Project Settings → API: paste URL + anon key above
# 2. SQL Editor: run supabase/setup_all.sql
# 3. Storage: bucket "log-images" (public for MVP), then supabase/storage_policies.sql
# 4. Auth → URL Configuration:
#      Site URL: http://localhost:3000
#      Redirect: http://localhost:3000/auth/callback
#      (add https://YOUR_APP.vercel.app/auth/callback after Vercel deploy)
#
# Full checklist: SETUP.md
